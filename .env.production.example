# Production environment template - copy to .env.production and fill values

# PostgreSQL (pgvector-enabled) - use Neon or Supabase
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public"

# Redis (Upstash or managed Redis)
REDIS_URL="redis://:<password>@<host>:6379"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Auth + app
JWT_SECRET="replace-with-strong-random-string"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Storage: use `s3` (AWS/DigitalOcean) or `minio` (self-hosted)
STORAGE_ADAPTER="s3"

# S3-compatible storage (AWS S3, DO Spaces, MinIO)
# S3_ENDPOINT should be the host only, e.g. `nyc3.digitaloceanspaces.com` or leave blank for AWS.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_USE_SSL="true"
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Worker
WORKER_CONCURRENCY=2

# Optional: TURN ON if you want verbose logs
# LOG_LEVEL=info
