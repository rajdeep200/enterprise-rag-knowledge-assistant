// Prisma schema for Enterprise RAG Knowledge Assistant
// pgvector note:
//   Prisma does not have a native `vector` scalar, so the embedding column is declared
//   with `Unsupported("vector(1536)")`. Prisma manages the column existence but we
//   read/write it via raw SQL (see services/embedding.service.ts and
//   services/vector-search.service.ts). The extension + index are created in a manual
//   SQL migration (prisma/migrations/00000000000000_enable_pgvector/migration.sql).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  ADMIN
  MEMBER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum FeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

model Company {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  documents    Document[]
  chatSessions ChatSession[]

  @@map("companies")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(MEMBER)
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents    Document[]    @relation("UploadedDocuments")
  chatSessions ChatSession[]
  feedback     AnswerFeedback[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([companyId])
  @@map("users")
}

model Document {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User            @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  title        String
  fileName     String
  filePath     String
  mimeType     String
  size         Int
  status       DocumentStatus  @default(UPLOADED)
  errorMessage String?
  totalPages   Int?
  totalChunks  Int             @default(0)
  chunks       DocumentChunk[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  companyId  String
  content    String
  pageNumber Int?
  chunkIndex Int
  // Vector column — managed by Prisma, read/written via raw SQL. 1536 dims = text-embedding-3-small.
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([companyId])
  @@map("document_chunks")
}

model ChatSession {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New chat")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([companyId])
  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String         @id @default(cuid())
  sessionId String
  session   ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  sources   Json?
  feedback  AnswerFeedback[]
  createdAt DateTime       @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

model AnswerFeedback {
  id        String         @id @default(cuid())
  messageId String
  message   ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    FeedbackRating
  comment   String?
  createdAt DateTime       @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("answer_feedback")
}
